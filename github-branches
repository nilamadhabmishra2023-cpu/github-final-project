# Required branch verification: main, bug-fix-typo, bug-fix-revert
# Run these commands from inside your cloned mcino-Introduction-to-Git-and-GitHub repository.
# These commands show real branch names and their tracking/status information.

$ git fetch origin
$ git branch -a -vv

# If a required branch is missing, check whether it exists on the remote:
$ git ls-remote --heads origin main bug-fix-typo bug-fix-revert

# If bug-fix-typo or bug-fix-revert does not exist locally but exists on origin, create tracking branches:
$ git switch --track origin/bug-fix-typo
# (If already on another branch, switch back as needed.)
$ git switch --track origin/bug-fix-revert

# Save actual command output for submission (run this from the repository):
{
  echo '$ git fetch origin'
  git fetch origin
  echo
  echo '$ git branch -a -vv'
  git branch -a -vv
  echo
  echo '$ git status'
  git status
} 2>&1 | tee github-branches

